{
  "schema": "composable-counter-allocation-cohorts-v1",
  "status": "frozen-before-measurement",
  "cycles": 3,
  "engine_order": ["composable", "rca"],
  "orders": [{"order": "forward", "role": "a"}, {"order": "reverse", "role": "b"}],
  "samples_per_engine": 6,
  "warmup": 20,
  "operations": 10000,
  "phases": ["construction", "warmup", "checked", "teardown", "setup"],
  "metrics": ["allocated_blocks", "allocated_bytes"],
  "instrument": "dhat-0.3.3",
  "features": ["allocation-measurement"],
  "interpretation": "retained-observations-and-absolute-differences-without-inference",
  "busy_host_allowed": true,
  "runner": "mac15-9-m3-max-16c-48gb-macos27plus-ac-high",
  "minimum_macos_major": 27,
  "rust_toolchain": "1.98.0",
  "target": "aarch64-apple-darwin",
  "cargo_jobs": 1,
  "incremental": false,
  "process_timeout_seconds": 60,
  "retry_failed_measurements": false
}
